# Optional: POST target for the contact form. Point it at the hosted Telegram
# bot's /api/contact route (see main.py). Leave it empty to show the Telegram
# handoff instead of a form — a static build has nowhere to deliver messages.
#
# The frontend error reporter, the WebGL context-loss reporter and the page-view
# ping derive /api/report and /api/ping from this same value, so one variable
# covers all three routes.
VITE_CONTACT_ENDPOINT=

# Optional: override the derived routes if the bot lives behind a rewrite.
VITE_REPORT_ENDPOINT=
VITE_PING_ENDPOINT=
